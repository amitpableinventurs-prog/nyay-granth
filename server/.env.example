# ---- Server ----
PORT=5070
JWT_SECRET=change-this-to-a-long-random-string
APP_NAME="Nyāya Grantha Sarvasvam"
# Public URL of the web app (used in links sent via WhatsApp etc.)
APP_URL=http://localhost:5070

# ---- Database: MongoDB (local mongod, or a MongoDB Atlas connection string) ----
MONGODB_URI=mongodb://127.0.0.1:27017/nayagranth

# ---- AI Assistance (any OpenAI-compatible Chat Completions API) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_FREE_DAILY_QUOTA=5

# ---- Payments: Razorpay and/or Stripe. Leave all blank for demo mode: plans activate without charging. ----
# With both set, users choose the gateway at checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Stripe secret key (sk_test_… / sk_live_…). Webhook endpoint: <APP_URL>/api/payments/stripe/webhook,
# event checkout.session.completed; paste its signing secret (whsec_…) below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=INR
# Extra web origins Stripe may return the browser to (comma-separated), e.g. the Vite dev server.
CLIENT_URLS=http://localhost:5185

# ---- WhatsApp ----
WHATSAPP_SUPPORT_NUMBER=919000000000
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Email (SMTP), used for password-reset codes. Leave SMTP_HOST blank to disable. ----
# Port 465 uses TLS from the start; 587 upgrades with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Social login (Google Identity Services web client ID) ----
GOOGLE_CLIENT_ID=

# ---- Share App: store links used in the share message (blank until the apps are published) ----
APP_SHARE_URL=
ANDROID_APP_URL=
IOS_APP_URL=

# ---- Contact details shown in the app ----
SUPPORT_EMAIL=support@nyayagrantha.org
CONTACT_ADDRESS="Varanasi, Uttar Pradesh, India"
